{
  "type": "mod",
  "id": "nox.xr.openvr",
  "provides": [
    "fr.hactazia.xr.openvr",
    "xr.openvr"
  ],
  "name": "XR OpenVR Loader",
  "version": "1.0.0",
  "description": "OpenVR (SteamVR) loader for Nox XR (Linux: Windows is OpenXR only).",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.xr.openvr",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.xr.openvr/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "xr",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.xr.git"
    },
    {
      "id": "com.valvesoftware.unity.openvr",
      "type": "depends",
      "register": "git+https://github.com/ValveSoftware/unity-xr-plugin.git?path=/com.valve.openvr"
    },
    {
      "id": "com.unity.modules.particlesystem",
      "type": "depends",
      "register": "upm+com.unity.modules.particlesystem@1.0.0"
    },
    {
      "id": "com.unity.modules.vehicles",
      "type": "depends",
      "register": "upm+com.unity.modules.vehicles@1.0.0"
    },
    {
      "id": "com.unity.modules.ai",
      "type": "depends",
      "register": "upm+com.unity.modules.ai@1.0.0"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "xr"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.XR.OpenVR.OpenVRLoaderProvider"
    ]
  }
}
